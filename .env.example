# Salin menjadi .env (JANGAN di-commit) lalu isi semua nilai bertanda WAJIB.
# Password dan secret: pakai huruf+angka saja (tanpa @ : / ? #) karena dipakai di dalam URL database.
# Contoh membuat nilai acak:  openssl rand -hex 24

# ---- jaringan
API_BIND_IP=192.168.10.20            # WAJIB: IP VM di jaringan lokal (bukan 0.0.0.0)
API_PORT=8000

# ---- gerbang IIS
GATEWAY_SECRET=                      # WAJIB: >= 24 karakter acak; sama dengan nilai X-Gateway-Secret di IIS
TRUSTED_PROXY_IPS=                   # opsional: IP server IIS (dipisah koma). Lihat docs/deploy.md sebelum mengisi.
ADMIN_USERS=AD-LAB\admin1            # WAJIB: DOMAIN\user, dipisah koma

# ---- database
POSTGRES_USER=pdftool_owner
POSTGRES_PASSWORD=                   # WAJIB: akun pemilik skema (tidak dipakai aplikasi)
POSTGRES_DB=pdftool
APP_DB_PASSWORD=                     # WAJIB: akun aplikasi pdftool_app (hanya SELECT + INSERT)

# ---- mesin merge
ENGINE=stirling                      # stirling | pypdf
STIRLING_IMAGE=stirlingtools/stirling-pdf:latest   # sematkan tag versi setelah diuji
ENGINE_TIMEOUT_S=300

# ---- batas
MAX_FILES=20
MAX_FILE_MB=50
MAX_TOTAL_MB=100
MAX_PAGES=2000
MAX_CONCURRENT=2
API_TMP_SIZE=2g
LOG_LEVEL=INFO
